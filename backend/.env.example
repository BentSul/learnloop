APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=learnloop
DB_USERNAME=learnloop
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Canvas (v0.8 §3.1). fixture = demo data in database/fixtures/canvas; hybrid = demo + real (hosting).
# token = the real Canvas API with each user's own access token; set CANVAS_BASE_URL too.
CANVAS_ADAPTER=fixture
CANVAS_BASE_URL=

# Hosting (docs/DEPLOY.md). hybrid = demo accounts use the sample data, others real Canvas.
# DEMO_PASSWORD sets the demo accounts' password when the demo data is loaded.
DEMO_PASSWORD=

# Sign in with Canvas (docs/DEPLOY.md §8): from a Canvas developer key; redirect URI defaults to APP_URL/api/canvas/oauth/callback
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=

# Optional (docs/DEPLOY.md §9): YouTube video suggestions and QuizAPI.io questions for lecturers
YOUTUBE_API_KEY=
QUIZAPI_KEY=
